# NVIDIA Canary 1B v2 (25 European languages, ASR + translation), UI+API on :9001.
#   make run-canary
# Passed with --env-file, so these values replace .env for this instance.

# --- host wiring -------------------------------------------------------------
# Host model-cache directory, mounted at /cache/hf; weights download on first start.
HF_HOME=/mnt/nvme/huggingface
CONTAINER_NAME=parakeet-asr-canary
HOST_PORT=9001

# --- model -------------------------------------------------------------------
# Empty MODEL_PATH = load from HuggingFace by MODEL_NAME.
MODEL_PATH=
MODEL_NAME=nvidia/canary-1b-v2
SERVED_MODEL_NAME=canary-1b-v2
# auto = bfloat16 on Ampere and newer: ~3x faster than fp32, WER unchanged.
TORCH_DTYPE=auto
MATMUL_PRECISION=high

# Canary defaults to en->en, i.e. it translates non-English audio. Slovak here;
# override per request with source_lang/target_lang.
DEFAULT_SOURCE_LANG=sk
DEFAULT_TARGET_LANG=sk

# --- live streaming (AED model) ----------------------------------------------
# Short context, fast commits: ~60 ms p50 lag, 9.17 % WER on the 120 s excerpt.
STREAM_CONTEXT_DURATION=1.5
STREAM_TRIM_DURATION=10
STREAM_MAX_DURATION=30
STREAM_STABLE_ITERS=2
# 12 sessions keep real time on one RTX 3090; 8 leaves headroom for batch traffic.
MAX_CONCURRENT_STREAMS=8

# --- limits / observability --------------------------------------------------
MAX_UPLOAD_MB=200
MAX_QUEUE_SIZE=32
METRICS_ENABLED=true
