# Deployment profile: NVIDIA Canary 1B v2 (25 European languages, ASR + translation).
#
#   GPU=1 make run-canary            # start on GPU 1, UI+API on http://localhost:9001
#   make stop-canary
#
# Used through the root Makefile, which passes this file to
# `docker compose -f docker-compose.prod.yml --env-file .env.canary`, so the
# values below (not .env) decide what this instance loads.

# --- host wiring -------------------------------------------------------------
# Host directory holding the model caches; mounted at /cache/hf in the container.
# The canary weights come from the HuggingFace cache (downloaded on first start).
HF_HOME=/mnt/nvme/huggingface
CONTAINER_NAME=parakeet-asr-canary
HOST_PORT=9001

# --- model -------------------------------------------------------------------
# Empty MODEL_PATH = load from HuggingFace by MODEL_NAME.
MODEL_PATH=
MODEL_NAME=nvidia/canary-1b-v2
SERVED_MODEL_NAME=canary-1b-v2
# auto = bfloat16 on Ampere and newer: ~3x faster than fp32, WER unchanged.
TORCH_DTYPE=auto
MATMUL_PRECISION=high

# Canary defaults to en->en, which *translates* non-English audio into English.
# This deployment is Slovak, so requests without language fields transcribe
# Slovak instead (override per request with source_lang/target_lang, or set
# target_lang=en on /v1/audio/translations to get English).
DEFAULT_SOURCE_LANG=sk
DEFAULT_TARGET_LANG=sk

# --- live streaming (tuned for the AED model) --------------------------------
# Canary is happy with short context and commits fast: ~60 ms p50 lag, 9.17 % WER
# on the 120 s Slovak excerpt. (The Parakeet profile needs wide context instead.)
STREAM_CONTEXT_DURATION=1.5
STREAM_TRIM_DURATION=10
STREAM_MAX_DURATION=30
STREAM_STABLE_ITERS=2
# Measured: 12 concurrent real-time sessions on one RTX 3090; 8 leaves headroom
# for batch traffic.
MAX_CONCURRENT_STREAMS=8

# --- limits / observability --------------------------------------------------
MAX_UPLOAD_MB=200
MAX_QUEUE_SIZE=32
METRICS_ENABLED=true
