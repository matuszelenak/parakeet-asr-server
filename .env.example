# Copy to .env and adjust as needed. docker compose reads it automatically.

# Number of model replicas. Leave empty for one per visible GPU.
NUM_WORKERS=

# Model to load.
MODEL_NAME=nvidia/canary-1b-v2
# Or a local .nemo checkpoint (takes precedence over MODEL_NAME for loading),
# e.g. a community fine-tune: /cache/hf/parakeet-ultra/ultra.nemo
# MODEL_PATH=

# Model id reported by GET /v1/models (e.g. for LiteLLM). Defaults to MODEL_NAME.
# SERVED_MODEL_NAME=parakeet

# SSE streaming (POST /v1/audio/transcriptions with stream=true): max seconds of
# audio transcribed per emitted delta.
# SSE_CHUNK_DURATION=20

# Max upload size (MB).
MAX_UPLOAD_MB=200

# --- Batching scheduler ------------------------------------------------------
# How long to wait for more requests before starting a batch (0 disables
# batching). Raise to ~80-100 for better throughput on many short requests,
# lower or set to 0 if you care more about single-request latency.
# BATCH_WINDOW_MS=20
# Requests decoded per model call.
# MAX_BATCH_SIZE=8
# Total audio (s) and per-item audio (s) allowed in one batch.
# MAX_BATCH_AUDIO_SECONDS=240
# MAX_BATCH_ITEM_SECONDS=30
# Max duration ratio inside a batch; mismatched lengths are decoded separately.
# BATCH_DURATION_RATIO=2
# Audio up to this length is passed to the model in memory instead of a temp WAV.
# INLINE_AUDIO_MAX_SECONDS=30

# --- Admission control -------------------------------------------------------
# Queued requests before new ones get 503 + Retry-After (0 = unlimited), how
# long a request may wait, and the Retry-After value.
# MAX_QUEUE_SIZE=32
# QUEUE_TIMEOUT_S=120
# RETRY_AFTER_S=2

# --- Live streaming limits ---------------------------------------------------
# Concurrent WebSocket sessions. 0 = auto (8 in bf16, 4 in fp32; an RTX 3090
# sustains 12 in bf16 with batching).
# MAX_CONCURRENT_STREAMS=0
# Audio a client may queue ahead of the model before the session is closed.
# STREAM_MAX_QUEUE_SECONDS=120
# Hard per-session duration limit.
# STREAM_MAX_SESSION_SECONDS=3600

# --- Inference numerics ------------------------------------------------------
# Model weight dtype: auto (bf16 on Ampere+, fp32 elsewhere), float32, bfloat16,
# float16. bf16 is ~3x faster for canary-1b-v2 and left WER unchanged in our
# tests; for transducer models (Parakeet TDT family) prefer float32, bf16 cost
# ~4 WER points on long audio.
# TORCH_DTYPE=auto
# fp32 matmul precision: high = TF32 tensor cores (byte-identical, ~1.9x),
# medium = bf16 matmuls (faster, changes numerics), highest = strict fp32.
# MATMUL_PRECISION=high

# --- Observability -----------------------------------------------------------
# Expose Prometheus metrics on GET /metrics.
# METRICS_ENABLED=true

# Logfire: set a token to ship logs/traces to Logfire. When unset, Logfire
# still renders to the console (send_to_logfire="if-token-present").
# LOGFIRE_TOKEN=

# The browser calls the API at the same origin it was opened from. The dev
# server proxies those calls to this backend address (compose network).
API_PROXY_TARGET=http://server:9000

# Optional: only set this to make the browser call a different API origin
# directly (bypassing the same-origin proxy).
# VITE_API_BASE=
