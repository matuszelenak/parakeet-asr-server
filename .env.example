# Copy to .env and adjust as needed. docker compose reads it automatically.

# Number of model replicas. Leave empty for one per visible GPU.
NUM_WORKERS=

# Model to load.
MODEL_NAME=nvidia/nemotron-3.5-asr-streaming-0.6b

# Streaming look-ahead [left,right] in 80 ms frames. The right context sets the
# latency: 56,0 ≈ 80 ms … 56,13 ≈ 1.12 s (more look-ahead = higher accuracy).
ATT_CONTEXT_SIZE=56,6

# Default language: a BCP-47 locale (e.g. de-DE) or "auto" to auto-detect.
TARGET_LANG=auto

# Max upload size (MB).
MAX_UPLOAD_MB=200

# Logfire: set a token to ship logs/traces to Logfire. When unset, Logfire
# still renders to the console (send_to_logfire="if-token-present").
# LOGFIRE_TOKEN=

# The browser calls the API at the same origin it was opened from. The dev
# server proxies those calls to this backend address (compose network).
API_PROXY_TARGET=http://server:9000

# Optional: only set this to make the browser call a different API origin
# directly (bypassing the same-origin proxy).
# VITE_API_BASE=
