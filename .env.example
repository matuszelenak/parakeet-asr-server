# Copy to .env and adjust as needed; docker compose reads it automatically.
# Every variable and its default: docs/configuration.md

# --- Model -------------------------------------------------------------------
MODEL_NAME=nvidia/canary-1b-v2
# Local .nemo instead of MODEL_NAME (wins for loading), e.g. a fine-tune:
# MODEL_PATH=/cache/hf/parakeet-ultra/ultra.nemo
# Id advertised by /v1/models; defaults to MODEL_NAME.
# SERVED_MODEL_NAME=parakeet
# Canary-style models default to en->en, which translates. Same value = transcribe.
# DEFAULT_SOURCE_LANG=sk
# DEFAULT_TARGET_LANG=sk
# Replicas; empty = one per visible GPU.
NUM_WORKERS=
# Host model-cache directory, mounted at /cache/hf.
# HF_HOME=/mnt/nvme/huggingface
MAX_UPLOAD_MB=200

# --- Numerics ----------------------------------------------------------------
# auto (bf16 on Ampere+) | float32 | bfloat16 | float16.
# Transducers (Parakeet TDT) want float32: bf16 costs ~4 WER points on long audio.
# TORCH_DTYPE=auto
# high = TF32 tensor cores (byte-identical, ~1.9x) | medium | highest.
# MATMUL_PRECISION=high

# --- Load --------------------------------------------------------------------
# Wait for more requests before decoding a batch (0 disables); 80-100 favours
# throughput over single-request latency.
# BATCH_WINDOW_MS=20
# Queued requests before 503 (0 = unlimited).
# MAX_QUEUE_SIZE=32
# Concurrent live sessions; 0 = auto (8 in bf16, 4 in fp32).
# MAX_CONCURRENT_STREAMS=0
# Live tuning is model-dependent (docs/benchmarks.md#live-streaming-tuning);
# a transducer wants wide context, e.g. 20 / 30 / 60 / 3.
# STREAM_CONTEXT_DURATION=1.5
# STREAM_TRIM_DURATION=10
# STREAM_MAX_DURATION=30
# STREAM_STABLE_ITERS=2

# --- Other -------------------------------------------------------------------
# SSE (stream=true): max seconds of audio per emitted delta.
# SSE_CHUNK_DURATION=20
# METRICS_ENABLED=true
# LOGFIRE_TOKEN=
# The dev server proxies the browser's same-origin calls to this address.
API_PROXY_TARGET=http://server:9000
# Only to make the browser call a different origin directly.
# VITE_API_BASE=
