# Deployment profile: Moondream Parakeet Ultra (post-trained parakeet-tdt-0.6b-v3).
#
#   GPU=0 make run-parakeet          # start on GPU 0, UI+API on http://localhost:9000
#   make stop-parakeet
#
# Used through the root Makefile, which passes this file to
# `docker compose -f docker-compose.prod.yml --env-file .env.parakeet`, so the
# values below (not .env) decide what this instance loads.

# --- host wiring -------------------------------------------------------------
# Host directory holding the model caches; mounted at /cache/hf in the container.
HF_HOME=/mnt/nvme/huggingface
CONTAINER_NAME=parakeet-asr-parakeet
HOST_PORT=9000

# --- model -------------------------------------------------------------------
# A local .nemo checkpoint (downloaded from ncannings/parakeet-ultra-nemo):
#   python -c "from huggingface_hub import hf_hub_download as d; \
#              d('ncannings/parakeet-ultra-nemo', 'ultra.nemo', local_dir='$HF_HOME/parakeet-ultra')"
MODEL_PATH=/cache/hf/parakeet-ultra/ultra.nemo
MODEL_NAME=parakeet-ultra
SERVED_MODEL_NAME=parakeet-ultra
# fp32: bf16 costs ~4 WER points on long audio with this transducer.
TORCH_DTYPE=float32
MATMUL_PRECISION=high

# --- live streaming (tuned for the transducer) --------------------------------
# On a 120 s Slovak excerpt: WER 6.25 % / CER 2.23 % with these values versus
# 9.58 % at the snappy defaults, at a commit lag of ~0.6 s (p50) instead of ~0.06 s.
STREAM_CONTEXT_DURATION=20
STREAM_TRIM_DURATION=30
STREAM_MAX_DURATION=60
STREAM_STABLE_ITERS=3
# 10 concurrent real-time sessions keep up comfortably on one RTX 3090 (12 is the edge).
MAX_CONCURRENT_STREAMS=10

# --- limits / observability --------------------------------------------------
MAX_UPLOAD_MB=200
MAX_QUEUE_SIZE=32
METRICS_ENABLED=true
